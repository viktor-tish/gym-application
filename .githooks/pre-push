#!/bin/bash

CURRENT_BRANCH=$(git branch --show-current)

if [[ "$CURRENT_BRANCH" != "develop" &&
      "$CURRENT_BRANCH" != feat/* &&
      "$CURRENT_BRANCH" != fix/* &&
      "$CURRENT_BRANCH" != refactor/*
]]; then
  echo "Branch is $CURRENT_BRANCH. Skipping local CI checks..."
  exit 0
fi

echo "Running CI checks before push..."

docker compose -f docker/docker-compose.test.yml up --build
RESULT=$?
docker compose -f docker/docker-compose.test.yml down

if [ $RESULT -ne 0 ]; then
  echo "Build or tests failed. Push aborted."
  echo "To bypass this check for a WIP commit, use: git push --no-verify"
  exit 1
fi

echo "All checks passed. Pushing..."
exit 0
